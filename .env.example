# Copiar a `.env` (no commiteado) y ajustar valores.
# El compose usa estos valores; si el fichero no existe, los defaults del yml aplican.

# Postgres
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox
POSTGRES_DB=toolbox
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=60

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
